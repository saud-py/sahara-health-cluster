# Copy to .env.local for local testing, and add the same keys in
# Netlify → Site configuration → Environment variables for production.
# Every value is optional; features switch on only when a value is set.

# Canonical domain once a custom domain is confirmed (no trailing slash).
# If unset, Netlify's own URL (e.g. https://your-site.netlify.app) is used.
NEXT_PUBLIC_SITE_URL=

# Google Ads tag ID (Google Ads → Tools → Data manager → Google tag), e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label for a "Phone call clicks on website" conversion action.
# From the conversion's event snippet: send_to: 'AW-123456789/AbC-dEfGhIjK' → AbC-dEfGhIjK
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=
# Optional conversion label for "Get directions" clicks (only fires once a map URL is configured).
NEXT_PUBLIC_GOOGLE_ADS_DIRECTIONS_LABEL=

# Optional Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Optional Google Search Console "HTML tag" verification token (content="..." value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
